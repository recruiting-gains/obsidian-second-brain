# Python / uv
.venv/
__pycache__/
*.pyc
*.pyo
.python-version

# Local config (never commit)
.env
*.local
.claude/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs
*.log

# Build output (regenerate with `bash scripts/build.sh`)
dist/

# Node / npm scratch. The rule is repo-wide because stray package.json files
# used to appear from tooling experiments and none of them belonged here.
node_modules/
.next/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml

# ...except the maintained Obsidian integrations, which are real npm packages
# and cannot build from a checkout without their manifests and lockfiles. The
# blanket rule above would otherwise make `npm ci` run against nothing.
!integrations/obsidian-plugin/package.json
!integrations/obsidian-plugin/package-lock.json
!integrations/neural-atlas-plugin/package.json
!integrations/neural-atlas-plugin/package-lock.json

# Per-vault retrieval eval cases (contain private note paths; generate locally)
scripts/eval/retrieval_cases*.jsonl
scripts/eval/behavior_cases.jsonl

# Cruz local-first extension
# `starter-vault/` is the sanitized, reviewable template. `vault/` is the live
# personal vault and must never be pushed with this public fork.
/vault/
/work/
/outputs/
*.private.json
