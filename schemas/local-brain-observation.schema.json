{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/local-brain-observation.schema.json",
  "title": "Local Brain Immutable Source Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "content_hash",
    "payload",
    "classification",
    "classification_rank",
    "metadata",
    "first_observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "payload": {
      "type": "string",
      "pattern": "^20 Sources/Raw/"
    },
    "classification": {
      "enum": ["public", "private-local", "sensitive", "restricted"]
    },
    "classification_rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "metadata": {
      "type": "object"
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
