{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/local-brain-source-envelope.schema.json",
  "title": "Local Brain Source Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source",
    "content_hash",
    "observed_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "string",
      "pattern": "^20 Sources/Raw/"
    },
    "retention": {
      "enum": ["keep", "review", "expire-derived-only", "legal-hold"]
    },
    "classification": {
      "enum": ["public", "private-local", "sensitive", "restricted"]
    }
  }
}
